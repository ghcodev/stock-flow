{
  "name": "stockflow-backend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "generate": "prisma generate",
    "db:pull": "node --env-file=.env node_modules/prisma/build/index.js db pull",
    "dev": "node --watch --env-file=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:local": "node --env-file=.env dist/server.js",
    "test": "node --env-file=.env --test \"tests/**/*.test.ts\"",
    "test:isolado": "bash scripts/testar-isolado.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "6.0.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "express-validator": "7.3.2",
    "jose": "6.2.17"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "prisma": "7.10.1",
    "typescript": "5.9.3"
  }
}
